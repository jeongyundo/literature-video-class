{
  "rules": {
    "live": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == '선생님구글메일@gmail.com' && auth.token.email_verified == true"
    },
    "presence": {
      ".read": "auth != null && auth.token.email == '선생님구글메일@gmail.com' && auth.token.email_verified == true",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "$lesson": {
      "live": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == '선생님구글메일@gmail.com' && auth.token.email_verified == true"
      },
      "presence": {
        ".read": "auth != null && auth.token.email == '선생님구글메일@gmail.com' && auth.token.email_verified == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    }
  }
}
